# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin:password123@db:5432/llm_governance

# ── Cloud provider API keys ──────────────────────────────────────────────────
# Leave blank for providers you don't use — the UI will show them as unconfigured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ── Settings encryption ───────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required if you want API keys saved via the Settings UI to be encrypted at rest.
# IMPORTANT: Replace before cloud deployment — use AWS Secrets Manager / GCP Secret Manager / Azure Key Vault.
SETTINGS_SECRET_KEY=

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama-service:11434/v1

# ── Default models ────────────────────────────────────────────────────────────
CLOUD_MODEL_NAME=gpt-4o
LOCAL_MODEL_NAME=llama3.2:latest
CLOUD_TIMEOUT=30.0
LOCAL_TIMEOUT=120.0

# ── Governance ────────────────────────────────────────────────────────────────
GOVERNANCE_POLICY_PATH=policies/default.yaml
